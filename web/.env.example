# Copy to .env (gitignored) and fill in. Never commit real values.

# Tenant connection — arch_app role. Every query goes through lib/db.ts's
# withAccount(), which sets app.account_id (RLS is FORCED on every table).
DATABASE_URL=postgresql://arch_app:dev@localhost:55432/postgres

# Sign-in lookup connection — arch_auth role (db/roles.sql). Resolves
# allowed_account by email, which the tenant role structurally cannot do (its
# policy is `id = current_account_id()`). Deliberately NOT a superuser: this
# role can read the allowlist and touch last_seen_at, and is denied every
# corpus table.
AUTH_DB_URL=postgresql://arch_auth:dev@localhost:55432/postgres

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Dev-only: adds a Credentials provider on the /login page that accepts a
# bare email, still gated by the same allowed_account check as Google. Only
# takes effect when NODE_ENV !== production. Leave unset/false normally —
# this exists because no Google OAuth app is registered against this local
# corpus, so there is no way to drive the real consent screen here.
AUTH_DEV_LOGIN=false

# Page renders live in a private Cloudflare R2 bucket, not Vercel Blob: Blob
# counts put/copy/list as Advanced Operations and includes 2,000 a month on
# Hobby, and one upload of this corpus is 1,512 of them. Reached only through
# the authenticated proxy at app/api/page-image.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PAGES=
