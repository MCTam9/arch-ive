# Copy to .env (gitignored) and fill in. Never commit real values.

# Neon Postgres
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_READONLY=postgresql://ro:pass@host/db?sslmode=require

# Cloudflare R2 (originals, encrypted client-side via rclone crypt)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
RCLONE_CONFIG=./private/rclone.conf
RCLONE_REMOTE=archive-crypt:

# Vercel Blob (page renders, private)
BLOB_READ_WRITE_TOKEN=

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OLLAMA_HOST=http://127.0.0.1:11434
VLM_MODEL=qwen2-vl

# Leak gate: path to the denylist, or the list itself
SCAN_DENYLIST=./private/denylist.txt

# Ingest
INBOX_DIR=./inbox
SOURCE_DIR=~/arch-ive-source
STABILITY_SECONDS=5
