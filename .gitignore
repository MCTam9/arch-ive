# ─── DATA: never commit source material ────────────────────────────────
# These are third-party client deliverables under copyright.
private/
inbox/
.tmp/
*.pdf
*.xlsx
*.xls
*.docx
*.pptx

# Legacy drop folders (pre-inbox). Contents move to inbox/ during ingest.
/Excel/
/PDF/
/Report - Guidance/
/Table - PDF/

# ─── SECRETS ───────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
rclone.conf
credentials.json
token.json

# ─── BUILD / RUNTIME ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.next/
out/
dist/
*.log
.ingest.lock

# ─── OS ────────────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes

# ─── web/ (Next.js UI) ───────────────────────────────────────────────────
web/node_modules/
web/.next/
web/.env*
!web/.env.example

# Argent Pixel CF is a commercial licence (Connary Fagen). The app loads it
# from web/public/fonts/ when present and falls back to the OFL bitmap faces
# when it isn't, so a public clone still renders -- but the binaries must
# never be redistributed through this repo.
web/public/fonts/*.otf
web/public/fonts/*.ttf
web/public/fonts/*.woff
web/public/fonts/*.woff2
